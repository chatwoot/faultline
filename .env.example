# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgres://localhost/faultline_development

# ─── Redis (Sidekiq + ActionCable) ─────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Security ──────────────────────────────────────────────
SECRET_KEY_BASE=generate-with-openssl-rand-hex-64
JWT_SECRET=change-me-in-production

# ─── Python Agent Service ─────────────────────────────────
AGENT_SERVICE_URL=http://localhost:8000
OPENAI_MODEL=codex-mini-latest
OPENAI_SUMMARY_MODEL=gpt-4.1-mini
AGENT_MAX_ITERATIONS=10
AGENT_MAX_TOOL_CALLS_PER_ITERATION=5

# ─── CORS / Frontend ──────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
VITE_WS_URL=ws://localhost:3000

# ─── Admin Account (optional - auto-creates verified admin) ────
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=secure-admin-password

# ─── Email Provider Configuration ──────────────────────────────
EMAIL_PROVIDER=smtp
# Options: smtp, resend, ses, sendgrid

# ─── SMTP (existing) ────────────────────────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_AUTH=plain
# SMTP_STARTTLS=true
# SMTP_FROM=noreply@faultline.dev
# MAILER_HOST=yourdomain.com
# MAILER_PROTOCOL=https

# ─── Resend API ─────────────────────────────────────────────────
# RESEND_API_KEY=your-resend-api-key

# ─── AWS SES ────────────────────────────────────────────────────
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# AWS_REGION=us-east-1

# ─── SendGrid ───────────────────────────────────────────────────
# SENDGRID_API_KEY=your-sendgrid-api-key

# ─── Rails Tuning (optional) ──────────────────────────────
# PORT=3000
# RAILS_MAX_THREADS=5
# SIDEKIQ_CONCURRENCY=5
# LOG_LEVEL=debug
